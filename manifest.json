{
  "id": "starlink",
  "name": "StarLink · 星图查询",
  "description": "供 Aide AI 调用的只读星图查询工具：摘要、节点搜索、来源详情和关系路径；无独立界面。",
  "version": "0.1.1",
  "author": "skyelan1999",
  "main": "index.js",
  "homepage": "https://github.com/skyelan1999/aide-pkg-StarLink",
  "settingsSchema": {
    "type": "object",
    "properties": {
      "includeCode": {
        "type": "boolean",
        "title": "默认包含代码分析",
        "default": true
      },
      "port": {
        "type": "integer",
        "title": "Aide 容器内部 HTTPS 端口",
        "default": 8080,
        "minimum": 1,
        "maximum": 65535
      },
      "dataDir": {
        "type": "string",
        "title": "Aide 运行数据目录",
        "default": "/data",
        "description": "读取本机访问令牌和证书的目录，只填写路径，不填写令牌。Docker 默认 /data。"
      }
    },
    "additionalProperties": false
  }
}
